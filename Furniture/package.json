    "express-rate-limit": "^8.6.2",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.11",
    "lucide-react": "^1.26.0",
    "nodemailer": "^9.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.11.0",
    "tailwindcss": "^4.3.3",
