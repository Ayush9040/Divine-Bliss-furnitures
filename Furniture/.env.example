# Gmail account used to notify the site owner. Enable 2-Step Verification and
# create a dedicated Google App Password; never use the account password here.
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
OWNER_EMAIL=divinebliss121@gmail.com

# Optional paid verification. Without these keys, the server uses
# validator.js + MX lookup for email and libphonenumber-js for Indian mobiles.
ABSTRACT_EMAIL_API_KEY=
ABSTRACT_PHONE_API_KEY=

# Use a persistent absolute path on the production server.
CONTACT_WORKBOOK_PATH=./server/data/contact-requests.xlsx
PORT=3001
